# Local development environment. Never commit the real .env file.
# Production must set ENVIRONMENT=production, a real SESSION_SECRET, HTTPS
# cookies, a PostgreSQL URL, and explicit non-wildcard ALLOWED_HOSTS.
ENVIRONMENT=development

# Application database connection.
#
# Supabase: copy the exact URI from Dashboard -> Connect and replace the
# password placeholder with the URL-encoded database password.  This app
# accepts either `postgresql://` (normalized to psycopg automatically) or
# `postgresql+psycopg://`.
#
# Local development may use a local PostgreSQL URL without TLS when the local
# database is intentionally configured that way. Production must validate the
# server certificate and hostname with sslmode=verify-full and the provider CA
# path supplied through the deployment secret facility.
#
# Use the direct production connection below for Alembic and other controlled
# migration jobs when IPv6 is available. It keeps a stable PostgreSQL session,
# which is important for schema migrations and tenant-context/RLS verification.
# DATABASE_URL=postgresql+psycopg://postgres:replace-with-url-encoded-database-password@db.ofggdmgfehutaoygjyod.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=/run/secrets/postgres-ca.pem
#
# Vercel is IPv4-only. For that deployment, use the *Session pooler* URI from
# the Supabase Connect dialog (do not infer the pooler host) and retain
# `sslmode=verify-full` and the provider CA path:
# DATABASE_URL=postgresql+psycopg://postgres.ofggdmgfehutaoygjyod:replace-with-url-encoded-database-password@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/run/secrets/postgres-ca.pem
DATABASE_URL=postgresql+psycopg://gym_user:replace-me@db:5432/gym_management

# Application/session settings.
SESSION_SECRET=replace-with-a-long-random-development-secret
SESSION_COOKIE_NAME=session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_TTL_SECONDS=28800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=5
LOGIN_RATE_LIMIT_SECONDS=600
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
PASSWORD_RESET_RATE_LIMIT_SECONDS=600
PASSWORD_RESET_MAX_REQUESTS=3
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL initialization value. Keep this equal to the password in DATABASE_URL.
POSTGRES_PASSWORD=replace-me
