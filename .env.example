# Local development environment. Never commit the real .env file.
ENVIRONMENT=development

# Application database connection.
DATABASE_URL=postgresql+psycopg://gym_user:replace-me@db:5432/gym_management

# Application/session settings.
SESSION_SECRET=replace-with-a-long-random-development-secret
SESSION_COOKIE_NAME=session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_TTL_SECONDS=28800
PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=5
LOGIN_RATE_LIMIT_SECONDS=600
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL initialization value. Keep this equal to the password in DATABASE_URL.
POSTGRES_PASSWORD=replace-me
